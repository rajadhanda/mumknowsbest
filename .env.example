# Copy to .env and fill in. .env is gitignored.

# Required — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Strongly recommended when the app is reachable from other devices: any secret
# string. Every /api call must then send it (the app asks for it once and saves it).
# MKB_ACCESS_TOKEN=

# Optional overrides (defaults shown)
# MKB_VISION_MODEL=claude-opus-4-8        # OCR of handwritten/Hinglish pages — accuracy first
# MKB_AGENT_MODEL=claude-opus-4-8         # the conversational assistant
# MKB_DB_PATH=recipes.db                  # SQLite file
# MKB_PHOTOS_DIR=photos                   # archived page photos, served at /api/photos
# MKB_LANGUAGE=a Hindi-English mix (Hinglish)
